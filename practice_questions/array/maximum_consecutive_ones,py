# Maximum Consecutive Ones

def MaximumConsecutiveOnes(arr):
    if len(arr)==0:
        return 0
    
    count=0
    max=0
    
    for i in range(len(arr)):
        if arr[i]==1:
            count=count+1
        if arr[i]!=1 and count>max:
            max=count
            count=0
    if count>max:
        max=count
    
    return max

arr=[]
print("The maximum consecutive ones are: ", MaximumConsecutiveOnes(arr))